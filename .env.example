DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

DATABASE_URL=postgresql://username:password@hostname:5432/database_name
DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password

DEFAULT_FROM_EMAIL=JLT Fragrances <noreply@your-domain.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
OWNER_NOTIFICATION_EMAIL=orders@your-domain.com

SITE_BASE_URL=https://your-domain.com
BRAND_LOGO_URL=https://your-domain.com/static/Images/logo.png
PRODUCT_CSV_PATH=store/data/JLT_Perfumes_Updated.csv

RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_CURRENCY=INR

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
